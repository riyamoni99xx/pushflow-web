# ==========================================================================
# PushFlow Backend — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit the real .env
# ==========================================================================

# ---- Server ----
NODE_ENV=production
PORT=5000
# Public URL of this backend (used in emails, verification links, etc.)
API_BASE_URL=https://pushflow-api.onrender.com
# Public URL of the frontend (used for CORS + redirect links)
FRONTEND_URL=https://pushflow.example.com

# ---- Firebase Admin SDK ----
# Option A (recommended on Render): paste the ENTIRE service account JSON as one line
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", "...":"..."}
# Option B: if you prefer separate fields instead of the JSON blob above, fill these
# and set FIREBASE_SERVICE_ACCOUNT_JSON to empty
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ---- Firebase Web (used only for verifying Google/GitHub ID tokens on client flow) ----
FIREBASE_WEB_API_KEY=

# ---- JWT ----
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN_REMEMBER=90d

# ---- Cookies ----
COOKIE_DOMAIN=
# true in production (HTTPS only)
COOKIE_SECURE=true

# ---- CORS ----
# Comma separated list of allowed origins (your frontend domains)
CORS_ORIGINS=https://pushflow.example.com,http://localhost:3000

# ---- Email (Nodemailer — used for verification + password reset) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=devmainulislam@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="PushFlow <no-reply@pushflow.example.com>"

# ---- OAuth (Google) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://pushflow-api.onrender.com/api/auth/google/callback

# ---- OAuth (GitHub) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://pushflow-api.onrender.com/api/auth/github/callback

# ---- Cron / Scheduler ----
# Secret required to hit /api/cron/trigger externally (UptimeRobot / cron-job.org backup)
CRON_SECRET=replace_with_a_random_secret

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
